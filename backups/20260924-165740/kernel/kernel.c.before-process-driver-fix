    [0x35] = '/',
    [0x39] = ' '
};

static char shifted_key(uint8_t code)
{
    switch (code) {
        case 0x02: return '!';
        case 0x03: return '@';
        case 0x04: return '#';
        case 0x05: return '$';
        case 0x06: return '%';
        case 0x07: return '^';
        case 0x08: return '&';
        case 0x09: return '*';
        case 0x0a: return '(';
        case 0x0b: return ')';
        case 0x0c: return '_';
        case 0x0d: return '+';
        case 0x27: return ':';
        case 0x28: return '"';
        case 0x33: return '<';
        case 0x34: return '>';
        case 0x35: return '?';
        default: return 0;
    }
}

static int keyboard_read_key(void)
{
    static int shift = 0;

    for (;;) {
        while ((port_in8(0x64) & 1) == 0)
            __asm__ volatile ("pause");

        uint8_t code = port_in8(0x60);

        if (code == 0x2a || code == 0x36) {
            shift = 1;
            continue;
        }

        if (code == 0xaa || code == 0xb6) {
            shift = 0;
            continue;
        }

        if (code & 0x80)
            continue;

        if (code == 0x1c)
            return 10;

        if (code == 0x0e)
            return 8;

        if (code == 0x0f)
            return 9;

        if (code == 0x01)
            return 27;

        if (code >= 128)
            continue;

        char c = keymap[code];

        if (shift) {
            char shifted = shifted_key(code);

            if (shifted)
                c = shifted;
            else if (c >= 'a' && c <= 'z')
                c = (char)(c - 'a' + 'A');
        }

        if (c)
            return (unsigned char)c;
    }
}

static int command_is(const char *command, const char *expected)
{
    uint32_t i = 0;

    while (command[i] && expected[i]) {
        if (command[i] != expected[i])
            return 0;

        i++;
    }

    return command[i] == 0 && expected[i] == 0;
}

static int command_starts_with(const char *command, const char *prefix)
{
    uint32_t i = 0;

    while (prefix[i]) {
        if (command[i] != prefix[i])
            return 0;

        i++;
    }

    return 1;
}

static void terminal_reboot(void)
{
    uint8_t status;

    do {
        status = port_in8(0x64);
    } while (status & 0x02);

    port_out8(0x64, 0xFE);

    for (;;)
        __asm__ volatile ("cli; hlt");
}


static void ramfs_print_entry(const char *name, uint8_t type)
{
    terminal_write(name);

    if (type == RAMFS_DIRECTORY)
        terminal_write("/");

    terminal_putc(10);
}

static void command_ls_ramfs(const char *path)
{
    if (!path || !path[0])
        path = "/";

    if (ramfs_list(path, ramfs_print_entry) < 0) {
        terminal_write("ls: no such directory");
        terminal_putc(10);
    }
}


static int auth_command(const char *command)
{
    if (command_is(command, "su") ||
        command_starts_with(command, "su ")) {
#if UNIOS_PASSWORD_CONFIGURED
        terminal_write("su: authentication backend is not implemented");
#else
        terminal_write("su: disabled; configure a password first");
#endif
        terminal_putc(10);
        return 1;
    }

    if (command_is(command, "sudo") ||
        command_starts_with(command, "sudo ")) {
#if UNIOS_PASSWORD_CONFIGURED
        terminal_write("sudo: authentication backend is not implemented");
#else
        terminal_write("sudo: disabled; configure a password first");
#endif
        terminal_putc(10);
        return 1;
    }

    return 0;
}


static int path_is_absolute(const char *path)
{
    return path && path[0] == '/';
}

static void path_join(
    char *output,
    const char *base,
    const char *path,
    uint32_t capacity
)
{
    uint32_t i = 0;
    uint32_t j = 0;

    if (!output || capacity == 0)
        return;

    output[0] = 0;

    if (path_is_absolute(path)) {
        while (path[j] && i + 1 < capacity)
            output[i++] = path[j++];
    } else {
        if (!base || !base[0])
            base = "/";

        while (base[j] && i + 1 < capacity)
            output[i++] = base[j++];

        if (i > 1 && i + 1 < capacity)
            output[i++] = '/';

        j = 0;

        while (path && path[j] && i + 1 < capacity)
            output[i++] = path[j++];
    }

    output[i] = 0;
}

static int path_parent(char *path)
{
    uint32_t length;
    uint32_t i;

    if (!path || !path[0])
        return -1;

    length = string_len(path);

    while (length > 1 && path[length - 1] == '/')
        length--;

    while (length > 1 && path[length - 1] != '/')
        length--;

    if (length <= 1) {
        path[0] = '/';
        path[1] = 0;
        return 0;
    }

    for (i = length - 1; i > 0 && path[i - 1] == '/'; i--)
        path[i] = 0;

    return 0;
}

static void path_normalize(char *path)
{
    char result[128];
    char component[32];
    uint32_t input = 0;
    uint32_t output = 0;

    if (!path || !path[0])
        return;

    result[0] = '/';
    output = 1;
    result[1] = 0;

    while (path[input]) {
        uint32_t length = 0;

        while (path[input] == '/')
            input++;

        if (!path[input])
            break;

        while (path[input] && path[input] != '/') {
            if (length + 1 >= sizeof(component))
                return;

            component[length++] = path[input++];
        }

        component[length] = 0;

        if (string_eq(component, "."))
            continue;

        if (string_eq(component, "..")) {
            path_parent(result);
            output = string_len(result);
            continue;
        }

        if (output > 1 && output + 1 < sizeof(result))
            result[output++] = '/';

        for (uint32_t i = 0;
             i < length && output + 1 < sizeof(result);
             i++) {
            result[output++] = component[i];
        }

        result[output] = 0;
    }

    if (output > 1 && result[output - 1] == '/')
        result[output - 1] = 0;

    string_copy(path, result, 128);
}

static int resolve_path(
    const char *argument,
    char *resolved,
    uint32_t capacity
)
{
    if (!argument || !argument[0] || !resolved || capacity == 0)
        return -1;

    path_join(resolved, cwd, argument, capacity);
    path_normalize(resolved);

    return 0;
}

static void command_cd_fixed(const char *argument)
{
    char resolved[128];

    if (!argument || !argument[0]) {
        string_copy(cwd, "/", sizeof(cwd));
        return;
    }

    if (resolve_path(argument, resolved, sizeof(resolved)) < 0) {
        terminal_write("cd: invalid path");
        terminal_putc(10);
        return;
    }

    if (!ramfs_is_directory(resolved)) {
        terminal_write("cd: no such directory");
        terminal_putc(10);
        return;
    }

    string_copy(cwd, resolved, sizeof(cwd));
}


static void terminal_shutdown(void)
{
    /*
     * Use QEMU's ISA debug-exit mechanism.
     * This exits the VM cleanly instead of hanging forever.
     */
    terminal_write("shutdown complete");
    terminal_putc(10);

    /* QEMU debug-exit: iobase=0x501, iosize=1 */
    port_out8(0x501, 0x00);

    /*
     * If the platform does not support debug-exit, halt safely.
     * This avoids a CPU loop that freezes the guest.
     */
    for (;;) {
        __asm__ volatile ("cli; hlt");
    }
}


struct unios_proc {
    int pid;
    char name[16];
    int alive;
};

static struct unios_proc proc_table[8];
static int proc_count = 0;

static void process_init(void)
{
    proc_count = 0;

    proc_table[proc_count].pid = 1;
    proc_table[proc_count].alive = 1;
    string_copy(proc_table[proc_count].name, "kernel", 16);
    proc_count++;

    proc_table[proc_count].pid = 2;
    proc_table[proc_count].alive = 1;
    string_copy(proc_table[proc_count].name, "shell", 16);
    proc_count++;
}

static void command_ps(void)
{
    terminal_write("PID COMMAND");
    terminal_putc(10);

    for (int i = 0; i < proc_count; i++) {
        char tmp[32];
        tmp[0] = 0;

        if (proc_table[i].pid < 10) {
            tmp[0] = '0' + proc_table[i].pid;
            tmp[1] = 0;
        } else {
            tmp[0] = '0' + (proc_table[i].pid / 10);
            tmp[1] = '0' + (proc_table[i].pid % 10);
            tmp[2] = 0;
        }

        terminal_write(tmp);
        terminal_putc(' ');
        terminal_write(proc_table[i].name);
        terminal_putc(10);
    }
}

static void command_kill(const char *arg)
{
    if (!arg || !arg[0]) {
        terminal_write("kill: missing pid");
        terminal_putc(10);
        return;
    }

    int pid = 0;

    for (int i = 0; arg[i] && arg[i] >= '0' && arg[i] <= '9'; i++) {
        pid = pid * 10 + (arg[i] - '0');
    }

    if (pid <= 0) {
        terminal_write("kill: invalid pid");
        terminal_putc(10);
        return;
    }

    for (int i = 0; i < proc_count; i++) {
        if (proc_table[i].pid == pid) {
            proc_table[i].alive = 0;
            terminal_write("killed");
            terminal_putc(10);
            return;
        }
    }

    terminal_write("kill: no such process");
    terminal_putc(10);
}

