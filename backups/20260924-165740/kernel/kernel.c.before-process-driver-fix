static void terminal_command(const char *command)
{
    if (auth_command(command))
        return;

    if (!command[0])
        return;

    if (command_is(command, "help")) {
        terminal_write("Unix: help about clear reboot shutdown echo uname whoami id pwd");
        terminal_putc(10);
        terminal_write("Files: ls cd cat mkdir rm");
        terminal_putc(10);
        terminal_write("Processes: ps kill");
        terminal_putc(10);
        terminal_write("Security: su sudo");
        terminal_putc(10);
        terminal_write("Space: scan orbit dock undock fuel crew nav comet airlock");
        terminal_putc(10);
        terminal_write("       starmap drivers");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "about")) {
        terminal_write("UNIOS: Universal Native Integrated Operating System");
        terminal_putc(10);
        terminal_write("compiler: Alien Compiler");
        terminal_putc(10);
        terminal_write("target: i386 Multiboot");
        terminal_putc(10);
        terminal_write("shell: OrbitCLI-compatible kernel terminal");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "clear")) {
        process_init();

    terminal_clear();
        return;
    }

    if (command_is(command, "reboot")) {
        terminal_write("rebooting...");
        terminal_putc(10);
        terminal_reboot();
        return;
    }

    if (command_is(command, "shutdown")) {
        terminal_write("shutting down...");
        terminal_putc(10);
        terminal_shutdown();
        return;
    }

    if (command_starts_with(command, "echo ")) {
        terminal_write(command + 5);
        terminal_putc(10);
        return;
    }

    if (command_is(command, "uname")) {
        terminal_write("UNIOS unios-kernel 0.1 i386");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "whoami")) {
        terminal_write("user");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "id")) {
        terminal_write("uid=1000(user) gid=1000(user) groups=1000(user)");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "pwd") || command_is(command, "nav")) {
        terminal_write("/");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "su")) {
        terminal_write("su: user authentication is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_starts_with(command, "su ")) {
        terminal_write("su: account database and authentication are not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "sudo") || command_starts_with(command, "sudo ")) {
        terminal_write("sudo: privilege escalation is disabled until users, passwords, and syscalls exist");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "ls")) {
        command_ls_ramfs(cwd);
        return;
    }

    if (command_starts_with(command, "ls ")) {
        command_ls_ramfs(command + 3);
        return;
    }

    if (command_is(command, "cat") ||
        command_starts_with(command, "cat ") ||
        command_is(command, "mkdir") ||
        command_starts_with(command, "mkdir ") ||
        command_is(command, "rm") ||
        command_starts_with(command, "rm ")) {
        terminal_write("filesystem support is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "ps") ||
        command_is(command, "kill") ||
        command_starts_with(command, "kill ")) {
        terminal_write("process management is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "mount") ||
        command_is(command, "umount") ||
        command_is(command, "dock") ||
        command_is(command, "undock") ||
        command_is(command, "starmap")) {
        terminal_write("storage and filesystem support are not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "scan") ||
        command_is(command, "orbit") ||
        command_is(command, "drivers")) {
        terminal_write("device manager is not connected to the kernel build yet");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "fuel")) {
        terminal_write("memory and resource reporting is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "crew")) {
        terminal_write("process listing is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "comet")) {
        terminal_write("file search requires filesystem support");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "airlock")) {
        terminal_write("safe file removal requires filesystem support");
        terminal_putc(10);
        return;
    }


    if (command_is(command, "cd")) {
        command_cd_fixed("/");
        return;
    }

    if (command_starts_with(command, "cd ")) {
        command_cd_fixed(command + 3);
        return;
    }

    terminal_write("unknown command");
    terminal_putc(10);
}

static void print_prompt(void)
{
    terminal_write("unios:");
    terminal_write(cwd);
    terminal_write("$ ");
}

static void terminal_readline(void)
{
    char buffer[128];
    uint32_t length = 0;

    print_prompt();

    for (;;) {
        int key = keyboard_read_key();

        if (key == 10) {
            buffer[length] = 0;
            terminal_putc(10);
            terminal_command(buffer);
            length = 0;
            print_prompt();
            continue;
        }

        if (key == 8) {
            if (length > 0) {
                length--;
                buffer[length] = 0;
                terminal_putc(8);
            }
            continue;
        }

        if (key >= 32 && key <= 126 &&
            length < sizeof(buffer) - 1) {
            buffer[length++] = (char)key;
            buffer[length] = 0;
            terminal_putc((char)key);
        }
    }
}

void kmain(uint32_t magic, uint32_t multiboot_info)
{
    (void)magic;
    (void)multiboot_info;

    ramfs_init();
    ramfs_mkdir("/home");
    ramfs_mkdir("/tmp");
    ramfs_mkdir("/etc");
    ramfs_touch("/etc/motd");
    ramfs_write("/etc/motd", "UNIOS in-memory filesystem");

    terminal_clear();

terminal_readline();

    for (;;) {
        __asm__ volatile ("hlt");
    }
}
