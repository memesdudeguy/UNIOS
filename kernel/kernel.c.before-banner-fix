#include <stdint.h>
#include "auth_config.h"
#include "ramfs.h"

static volatile uint16_t *const VGA = (uint16_t *)0xB8000;
static uint8_t row = 0;
static uint8_t col = 0;
static const uint8_t color = 0x07;


static void port_out8(uint16_t port, uint8_t value)
{
    __asm__ volatile (
        "outb %0, %1"
        :
        : "a"(value), "Nd"(port)
    );
}

static void terminal_cursor_update(void)
{
    uint16_t position = (uint16_t)row * 80u + col;

    port_out8(0x3D4, 0x0F);
    port_out8(0x3D5, (uint8_t)(position & 0xFF));

    port_out8(0x3D4, 0x0E);
    port_out8(0x3D5, (uint8_t)(position >> 8));

    /* Enable a blinking underline cursor */
    port_out8(0x3D4, 0x0A);
    port_out8(0x3D5, 0x0E);

    port_out8(0x3D4, 0x0B);
    port_out8(0x3D5, 0x0F);
}

static void terminal_clear(void)
{
    for (uint32_t i = 0; i < 80 * 25; i++)
        VGA[i] = ((uint16_t)color << 8) | ' ';

    row = 0;
    col = 0;
    terminal_cursor_update();
}

static void terminal_putc(char c)
{
    if (c == 10) {
        col = 0;
        row++;

        if (row >= 25)
            row = 0;

        terminal_cursor_update();
        return;
    }

    if (c == 8) {
        if (col > 0) {
            col--;
            VGA[row * 80 + col] =
                ((uint16_t)color << 8) | ' ';
        }

        terminal_cursor_update();
        return;
    }

    if (col >= 80) {
        col = 0;
        row++;
    }

    if (row >= 25)
        row = 0;

    VGA[row * 80 + col] =
        ((uint16_t)color << 8) | (uint8_t)c;

    col++;
    terminal_cursor_update();
}

static void terminal_write(const char *text)
{
    while (*text)
        terminal_putc(*text++);
}

static uint8_t port_in8(uint16_t port)
{
    uint8_t value;

    __asm__ volatile (
        "inb %1, %0"
        : "=a"(value)
        : "Nd"(port)
    );

    return value;
}

static char keymap[128] = {
    [0x02] = '1',
    [0x03] = '2',
    [0x04] = '3',
    [0x05] = '4',
    [0x06] = '5',
    [0x07] = '6',
    [0x08] = '7',
    [0x09] = '8',
    [0x0a] = '9',
    [0x0b] = '0',
    [0x0c] = '-',
    [0x0d] = '=',
    [0x10] = 'q',
    [0x11] = 'w',
    [0x12] = 'e',
    [0x13] = 'r',
    [0x14] = 't',
    [0x15] = 'y',
    [0x16] = 'u',
    [0x17] = 'i',
    [0x18] = 'o',
    [0x19] = 'p',
    [0x1e] = 'a',
    [0x1f] = 's',
    [0x20] = 'd',
    [0x21] = 'f',
    [0x22] = 'g',
    [0x23] = 'h',
    [0x24] = 'j',
    [0x25] = 'k',
    [0x26] = 'l',
    [0x2c] = 'z',
    [0x2d] = 'x',
    [0x2e] = 'c',
    [0x2f] = 'v',
    [0x30] = 'b',
    [0x31] = 'n',
    [0x32] = 'm',
    [0x27] = ';',
    [0x28] = '\'',
    [0x29] = '`',
    [0x33] = ',',
    [0x34] = '.',
    [0x35] = '/',
    [0x39] = ' '
};

static char shifted_key(uint8_t code)
{
    switch (code) {
        case 0x02: return '!';
        case 0x03: return '@';
        case 0x04: return '#';
        case 0x05: return '$';
        case 0x06: return '%';
        case 0x07: return '^';
        case 0x08: return '&';
        case 0x09: return '*';
        case 0x0a: return '(';
        case 0x0b: return ')';
        case 0x0c: return '_';
        case 0x0d: return '+';
        case 0x27: return ':';
        case 0x28: return '"';
        case 0x33: return '<';
        case 0x34: return '>';
        case 0x35: return '?';
        default: return 0;
    }
}

static int keyboard_read_key(void)
{
    static int shift = 0;

    for (;;) {
        while ((port_in8(0x64) & 1) == 0)
            __asm__ volatile ("pause");

        uint8_t code = port_in8(0x60);

        if (code == 0x2a || code == 0x36) {
            shift = 1;
            continue;
        }

        if (code == 0xaa || code == 0xb6) {
            shift = 0;
            continue;
        }

        if (code & 0x80)
            continue;

        if (code == 0x1c)
            return 10;

        if (code == 0x0e)
            return 8;

        if (code == 0x0f)
            return 9;

        if (code == 0x01)
            return 27;

        if (code >= 128)
            continue;

        char c = keymap[code];

        if (shift) {
            char shifted = shifted_key(code);

            if (shifted)
                c = shifted;
            else if (c >= 'a' && c <= 'z')
                c = (char)(c - 'a' + 'A');
        }

        if (c)
            return (unsigned char)c;
    }
}

static int command_is(const char *command, const char *expected)
{
    uint32_t i = 0;

    while (command[i] && expected[i]) {
        if (command[i] != expected[i])
            return 0;

        i++;
    }

    return command[i] == 0 && expected[i] == 0;
}

static int command_starts_with(const char *command, const char *prefix)
{
    uint32_t i = 0;

    while (prefix[i]) {
        if (command[i] != prefix[i])
            return 0;

        i++;
    }

    return 1;
}

static void terminal_reboot(void)
{
    uint8_t status;

    do {
        status = port_in8(0x64);
    } while (status & 0x02);

    port_out8(0x64, 0xFE);

    for (;;)
        __asm__ volatile ("cli; hlt");
}


static void ramfs_print_entry(const char *name, uint8_t type)
{
    terminal_write(name);

    if (type == RAMFS_DIRECTORY)
        terminal_write("/");

    terminal_putc(10);
}

static void command_ls_ramfs(const char *path)
{
    if (!path || !path[0])
        path = "/";

    if (ramfs_list(path, ramfs_print_entry) < 0) {
        terminal_write("ls: no such directory");
        terminal_putc(10);
    }
}


static int auth_command(const char *command)
{
    if (command_is(command, "su") ||
        command_starts_with(command, "su ")) {
#if UNIOS_PASSWORD_CONFIGURED
        terminal_write("su: authentication backend is not implemented");
#else
        terminal_write("su: disabled; configure a password first");
#endif
        terminal_putc(10);
        return 1;
    }

    if (command_is(command, "sudo") ||
        command_starts_with(command, "sudo ")) {
#if UNIOS_PASSWORD_CONFIGURED
        terminal_write("sudo: authentication backend is not implemented");
#else
        terminal_write("sudo: disabled; configure a password first");
#endif
        terminal_putc(10);
        return 1;
    }

    return 0;
}

static void terminal_command(const char *command)
{
    if (auth_command(command))
        return;

    if (!command[0])
        return;

    if (command_is(command, "help")) {
        terminal_write("Unix: help about clear reboot shutdown echo uname whoami id pwd");
        terminal_putc(10);
        terminal_write("Files: ls cd cat mkdir rm");
        terminal_putc(10);
        terminal_write("Processes: ps kill");
        terminal_putc(10);
        terminal_write("Security: su sudo");
        terminal_putc(10);
        terminal_write("Space: scan orbit dock undock fuel crew nav comet airlock");
        terminal_putc(10);
        terminal_write("       starmap drivers");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "about")) {
        terminal_write("UNIOS: Universal Native Integrated Operating System");
        terminal_putc(10);
        terminal_write("compiler: Alien Compiler");
        terminal_putc(10);
        terminal_write("target: i386 Multiboot");
        terminal_putc(10);
        terminal_write("shell: OrbitCLI-compatible kernel terminal");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "clear")) {
        terminal_clear();
        return;
    }

    if (command_is(command, "reboot")) {
        terminal_write("rebooting...");
        terminal_putc(10);
        terminal_reboot();
        return;
    }

    if (command_is(command, "shutdown")) {
        terminal_write("shutdown requested; ACPI power control is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_starts_with(command, "echo ")) {
        terminal_write(command + 5);
        terminal_putc(10);
        return;
    }

    if (command_is(command, "uname")) {
        terminal_write("UNIOS unios-kernel 0.1 i386");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "whoami")) {
        terminal_write("user");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "id")) {
        terminal_write("uid=1000(user) gid=1000(user) groups=1000(user)");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "pwd") || command_is(command, "nav")) {
        terminal_write("/");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "su")) {
        terminal_write("su: user authentication is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_starts_with(command, "su ")) {
        terminal_write("su: account database and authentication are not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "sudo") || command_starts_with(command, "sudo ")) {
        terminal_write("sudo: privilege escalation is disabled until users, passwords, and syscalls exist");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "ls")) {
        command_ls_ramfs("/");
        return;
    }

    if (command_starts_with(command, "ls ")) {
        command_ls_ramfs(command + 3);
        return;
    }

    if (command_is(command, "cd") || command_starts_with(command, "cd ")) {
        terminal_write("cd: filesystem and process path state are not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "cat") ||
        command_starts_with(command, "cat ") ||
        command_is(command, "mkdir") ||
        command_starts_with(command, "mkdir ") ||
        command_is(command, "rm") ||
        command_starts_with(command, "rm ")) {
        terminal_write("filesystem support is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "ps") ||
        command_is(command, "kill") ||
        command_starts_with(command, "kill ")) {
        terminal_write("process management is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "mount") ||
        command_is(command, "umount") ||
        command_is(command, "dock") ||
        command_is(command, "undock") ||
        command_is(command, "starmap")) {
        terminal_write("storage and filesystem support are not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "scan") ||
        command_is(command, "orbit") ||
        command_is(command, "drivers")) {
        terminal_write("device manager is not connected to the kernel build yet");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "fuel")) {
        terminal_write("memory and resource reporting is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "crew")) {
        terminal_write("process listing is not implemented");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "comet")) {
        terminal_write("file search requires filesystem support");
        terminal_putc(10);
        return;
    }

    if (command_is(command, "airlock")) {
        terminal_write("safe file removal requires filesystem support");
        terminal_putc(10);
        return;
    }

    terminal_write("unknown command");
    terminal_putc(10);
}

static void terminal_readline(void)
{
    char buffer[128];
    uint32_t length = 0;

    terminal_write("unios:/$ ");

    for (;;) {
        int key = keyboard_read_key();

        if (key == 10) {
            buffer[length] = 0;
            terminal_putc(10);
            terminal_command(buffer);
            length = 0;
            terminal_write("unios:/$ ");
            continue;
        }

        if (key == 8) {
            if (length > 0) {
                length--;
                buffer[length] = 0;
                terminal_putc(8);
            }
            continue;
        }

        if (key >= 32 && key <= 126 &&
            length < sizeof(buffer) - 1) {
            buffer[length++] = (char)key;
            buffer[length] = 0;
            terminal_putc((char)key);
        }
    }
}

void kmain(uint32_t magic, uint32_t multiboot_info)
{
    (void)magic;
    (void)multiboot_info;

    ramfs_init();
    ramfs_mkdir("/home");
    ramfs_mkdir("/tmp");
    ramfs_mkdir("/etc");
    ramfs_touch("/etc/motd");
    ramfs_write("/etc/motd", "UNIOS in-memory filesystem");

    terminal_clear();

    terminal_write("UNIOS booted");
    terminal_putc(10);
    terminal_write("Alien Compiler kernel");
    terminal_putc(10);
    terminal_write("Minimal built-in terminal active");
    terminal_putc(10);
terminal_readline();

    for (;;) {
        __asm__ volatile ("hlt");
    }
}
